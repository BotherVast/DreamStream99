{
  "manifest_version": 3,
  "name": "Watch Together · Bilibili Bridge",
  "version": "0.2.0",
  "description": "Bilibili playback bridge for Watch Together.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Watch Together",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
